{
  "manifest_version": 3,
  "name": "Sahayak AI · Government Form Helper",
  "version": "1.0.0",
  "description": "Prefills supported government scheme forms from your saved Jan Sahayak profile. You stay in control of verification and submission.",
  "permissions": ["activeTab", "storage", "notifications", "offscreen"],
  "host_permissions": [
    "https://gov.in/*",
    "https://*.gov.in/*",
    "https://nic.in/*",
    "https://*.nic.in/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": ["https://*/*", "https://cdn.jsdelivr.net/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Sahayak AI · Government Form Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [{"resources":["icons/*.png","vendor/tesseract/worker.min.js","vendor/tesseract-core/*","vendor/pdfjs/pdf.worker.min.mjs"],"matches":["https://gov.in/*","https://*.gov.in/*","https://nic.in/*","https://*.nic.in/*","http://localhost/*"]}],
  "content_scripts": [{
    "matches": ["https://gov.in/*", "https://*.gov.in/*", "https://nic.in/*", "https://*.nic.in/*", "http://localhost/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
