# Groq API key for chat, browser search, and recorded voice transcription.
GROQ_API_KEY=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
# Browser search works with Groq GPT-OSS models. Keep these defaults for live web answers.
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_WEB_SEARCH=true
# Groq speech-to-text model for recorded voice notes.
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Neon PostgreSQL connection string. In Neon, enable SSL for the connection.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Required to sign login JWTs. Use a long random value; keep it secret.
AUTH_JWT_SECRET=replace-with-a-long-random-secret

# Optional WhatsApp Cloud API webhook delivery
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-token
WHATSAPP_APP_SECRET=
PORT=3000
