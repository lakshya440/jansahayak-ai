# Gemini API key (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional model to try if the primary Gemini model is temporarily overloaded.
GEMINI_FALLBACK_MODEL=

# Neon PostgreSQL connection string. In Neon, enable SSL for the connection.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Required to sign login JWTs. Use a long random value; keep it secret.
AUTH_JWT_SECRET=replace-with-a-long-random-secret

# Optional WhatsApp Cloud API webhook delivery
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-token
WHATSAPP_APP_SECRET=
PORT=3000